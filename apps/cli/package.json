{
  "name": "@agent-metrics/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent-metrics": "dist/index.js"
  },
  "scripts": {
    "postinstall": "node scripts/link-bin.mjs",
    "prebuild": "corepack pnpm --filter @agent-metrics/adapters-claude... build",
    "build": "tsc -p tsconfig.json",
    "pretest": "corepack pnpm --filter @agent-metrics/adapters-claude... build",
    "dev": "tsx src/index.ts",
    "test": "node ../../scripts/run-tests.mjs run src"
  },
  "dependencies": {
    "@agent-metrics/adapters-claude": "workspace:*",
    "@agent-metrics/event-schema": "workspace:*",
    "@agent-metrics/shared-utils": "workspace:*",
    "commander": "^12.1.0"
  }
}
